{
  "name": "inapyuk",
  "version": "0.1.0",
  "private": true,
  "description": "InapYuk - property renting web app (Purwadhika final project)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "npm run build --workspace=@inapyuk/types && npm run db:generate --workspace=@inapyuk/api",
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:web": "npm run dev --workspace=@inapyuk/web",
    "dev:api": "npm run dev --workspace=@inapyuk/api",
    "build": "npm run build --workspace=@inapyuk/types && npm run build --workspace=@inapyuk/api && npm run build --workspace=@inapyuk/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "db:generate": "npm run db:generate --workspace=@inapyuk/api",
    "db:migrate": "npm run db:migrate --workspace=@inapyuk/api",
    "db:push": "npm run db:push --workspace=@inapyuk/api",
    "db:seed": "npm run db:seed --workspace=@inapyuk/api",
    "db:studio": "npm run db:studio --workspace=@inapyuk/api"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "prettier": "^3.4.2"
  }
}
