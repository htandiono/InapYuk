# ---------------------------------------------------------------------------
# Database (Neon PostgreSQL)
# DATABASE_URL  -> pooled connection, used by the running app
# DIRECT_URL    -> direct connection, used by prisma migrate
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/inapyuk?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/inapyuk?sslmode=require"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV="development"
PORT="8000"
API_PREFIX="/api"
CORS_ORIGIN="http://localhost:3000"
WEB_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-me-with-another-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Minutes a verification / reset link stays valid (spec requires 60).
VERIFICATION_TOKEN_TTL_MINUTES="60"

# Google OAuth (social login)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Booking rules
# ---------------------------------------------------------------------------
# Minutes a user has to upload payment proof before the booking auto-cancels.
PAYMENT_DEADLINE_MINUTES="60"

# ---------------------------------------------------------------------------
# Mail (nodemailer SMTP)
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM_NAME="InapYuk"
MAIL_FROM_ADDRESS="no-reply@inapyuk.space"

# ---------------------------------------------------------------------------
# Uploads (Cloudinary; falls back to local disk when unset)
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------------------------------------------------------------------------
# Scheduled jobs
# Shared secret required by POST /api/cron/*. In production Vercel Cron sends
# it; in local dev the in-process node-cron runner uses it.
# ---------------------------------------------------------------------------
CRON_SECRET="replace-me-with-a-random-string"
ENABLE_LOCAL_CRON="true"
