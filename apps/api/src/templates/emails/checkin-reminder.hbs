<!doctype html>
<html lang="id">
  <body style="margin:0;padding:24px;background:#f6f7f9;font-family:Arial,Helvetica,sans-serif;color:#1f2937">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;padding:32px">
            <tr>
              <td>
                <h1 style="margin:0 0 8px;font-size:22px;color:#0f766e">{{appName}}</h1>
                <p style="margin:0 0 24px;font-size:14px;color:#6b7280">Pengingat check-in besok</p>

                <p style="font-size:15px;line-height:1.6">Halo <strong>{{guestName}}</strong>,</p>
                <p style="font-size:15px;line-height:1.6">
                  Menginap kamu di <strong>{{propertyName}}</strong> dimulai besok,
                  <strong>{{checkIn}}</strong>. Sampai jumpa!
                </p>

                <table role="presentation" width="100%" cellpadding="8" cellspacing="0"
                       style="margin:20px 0;border:1px solid #e5e7eb;border-radius:8px;font-size:14px">
                  <tr><td style="color:#6b7280">No. pesanan</td><td align="right"><strong>{{orderNumber}}</strong></td></tr>
                  <tr><td style="color:#6b7280">Kamar</td><td align="right">{{roomName}}</td></tr>
                  <tr><td style="color:#6b7280">Alamat</td><td align="right">{{propertyAddress}}</td></tr>
                  <tr><td style="color:#6b7280">Check-out</td><td align="right">{{checkOut}}</td></tr>
                </table>

                <p style="font-size:13px;color:#6b7280;line-height:1.6">
                  Tunjukkan nomor pesanan ini saat tiba di properti.
                </p>

                <p style="margin:28px 0 0">
                  <a href="{{bookingUrl}}"
                     style="background:#0f766e;color:#ffffff;text-decoration:none;padding:12px 24px;border-radius:8px;font-size:15px;display:inline-block">
                    Lihat Detail Pesanan
                  </a>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
