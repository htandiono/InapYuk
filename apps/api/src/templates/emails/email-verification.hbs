<!doctype html>
<html lang="id">
  <body style="margin:0;padding:24px;background:#f6f7f9;font-family:Arial,Helvetica,sans-serif;color:#1f2937">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td align="center">
          <table role="presentation" width="560" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;padding:32px">
            <tr>
              <td>
                <h1 style="margin:0 0 8px;font-size:22px;color:#0f766e">{{appName}}</h1>
                <p style="margin:0 0 24px;font-size:14px;color:#6b7280">Verifikasi alamat email kamu</p>

                <p style="font-size:15px;line-height:1.6">Halo <strong>{{name}}</strong>,</p>
                <p style="font-size:15px;line-height:1.6">
                  Terima kasih sudah mendaftar di {{appName}}. Klik tombol di bawah untuk
                  memverifikasi email dan membuat password kamu.
                </p>

                <p style="margin:28px 0">
                  <a href="{{verificationUrl}}"
                     style="background:#0f766e;color:#ffffff;text-decoration:none;padding:12px 24px;border-radius:8px;font-size:15px;display:inline-block">
                    Verifikasi &amp; Buat Password
                  </a>
                </p>

                <p style="font-size:13px;color:#6b7280;line-height:1.6">
                  Tautan ini hanya berlaku <strong>{{expiresInMinutes}} menit</strong> dan hanya
                  dapat digunakan satu kali. Jika kamu tidak merasa mendaftar, abaikan email ini.
                </p>

                <hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0" />
                <p style="font-size:12px;color:#9ca3af;word-break:break-all">
                  Tombol tidak berfungsi? Salin tautan ini: {{verificationUrl}}
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
