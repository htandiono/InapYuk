# ---------------------------------------------------------------------------
# Test environment — minimal values to pass env.ts Zod validation
# ---------------------------------------------------------------------------
NODE_ENV="test"
PORT="8001"
API_PREFIX="/api"
CORS_ORIGIN="http://localhost:3000"
WEB_BASE_URL="http://localhost:3000"

# Extracted from mini-project: local Postgres
DATABASE_URL="postgresql://eventure:eventure_dev_only@localhost:5432/inapyuk_test?schema=public"

JWT_ACCESS_SECRET="test-access-secret-minimum-16-chars"
JWT_REFRESH_SECRET="test-refresh-secret-minimum-16-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
VERIFICATION_TOKEN_TTL_MINUTES="60"

PAYMENT_DEADLINE_MINUTES="60"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"

MAIL_FROM_NAME="InapYuk Test"
MAIL_FROM_ADDRESS="test@inapyuk.space"

CRON_SECRET="test-cron-secret-minimum-8"
ENABLE_LOCAL_CRON="false"
