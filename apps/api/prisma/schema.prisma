// InapYuk - Property Renting Web App
//
// This schema is SHARED between Feature 1 (awanstywn) and Feature 2 (htandiono).
// It was designed jointly during the preparation phase so neither feature is
// blocked waiting on the other. Any change here needs a PR both of us review.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
  TENANT
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  EMAIL_CHANGE
}

enum BookingStatus {
  WAITING_PAYMENT
  WAITING_CONFIRMATION
  PROCESSED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  MANUAL_TRANSFER
  PAYMENT_GATEWAY
}

enum PriceAdjustmentType {
  NOMINAL
  PERCENTAGE
}

enum CancelledBy {
  USER
  TENANT
  SYSTEM
}

enum NotificationType {
  BOOKING_CREATED
  PAYMENT_UPLOADED
  PAYMENT_ACCEPTED
  PAYMENT_REJECTED
  BOOKING_CANCELLED
  CHECKIN_REMINDER
  REVIEW_REPLY
}

// ---------------------------------------------------------------------------
// Identity - owned by Feature 1
// ---------------------------------------------------------------------------

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String?
  name         String
  phone        String?
  role         UserRole     @default(USER)
  provider     AuthProvider @default(EMAIL)
  providerId   String?
  isVerified   Boolean      @default(false)
  avatarUrl    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  tenantProfile      TenantProfile?
  verificationTokens VerificationToken[]
  refreshTokens      RefreshToken[]
  bookings           Booking[]
  reviews            Review[]
  notifications      Notification[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

model TenantProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  companyName    String
  companyAddress String?
  bankName       String?
  bankAccount    String?
  logoUrl        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties  Property[]
  categories  PropertyCategory[]
  reviewReply ReviewReply[]

  @@map("tenant_profiles")
}

/// Backs email verification, password reset and email change.
/// `usedAt` enforces single use; `expiresAt` enforces the one-hour window.
model VerificationToken {
  id        String                @id @default(uuid())
  userId    String
  tokenHash String                @unique
  type      VerificationTokenType
  newEmail  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
  @@map("verification_tokens")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Inventory - owned by Feature 1
// ---------------------------------------------------------------------------

model PropertyCategory {
  id        String    @id @default(uuid())
  tenantId  String
  name      String
  slug      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant     TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  properties Property[]

  @@unique([tenantId, slug])
  @@map("property_categories")
}

model Property {
  id          String    @id @default(uuid())
  tenantId    String
  categoryId  String
  name        String
  slug        String    @unique
  description String    @db.Text
  city        String
  province    String
  address     String
  latitude    Float?
  longitude   Float?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  tenant   TenantProfile    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category PropertyCategory @relation(fields: [categoryId], references: [id])
  images   PropertyImage[]
  rooms    Room[]
  bookings Booking[]
  reviews  Review[]

  @@index([city])
  @@index([tenantId])
  @@index([deletedAt])
  @@map("properties")
}

model PropertyImage {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

model Room {
  id          String    @id @default(uuid())
  propertyId  String
  name        String
  description String    @db.Text
  basePrice   Decimal   @db.Decimal(12, 2)
  capacity    Int       @default(2)
  totalUnits  Int       @default(1)
  imageUrl    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  property         Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  availabilities   RoomAvailability[]
  peakSeasonRates  PeakSeasonRate[]
  bookings         Booking[]

  @@index([propertyId])
  @@index([deletedAt])
  @@map("rooms")
}

/// One row per room per calendar date. Absence of a row means "bookable at
/// default capacity", so tenants only persist the exceptions they set.
model RoomAvailability {
  id             String   @id @default(uuid())
  roomId         String
  date           DateTime @db.Date
  isAvailable    Boolean  @default(true)
  availableUnits Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, date])
  @@index([date])
  @@map("room_availabilities")
}

model PeakSeasonRate {
  id              String              @id @default(uuid())
  roomId          String
  name            String
  startDate       DateTime            @db.Date
  endDate         DateTime            @db.Date
  adjustmentType  PriceAdjustmentType
  adjustmentValue Decimal             @db.Decimal(12, 2)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, startDate, endDate])
  @@map("peak_season_rates")
}

// ---------------------------------------------------------------------------
// Transactions - owned by Feature 2
// ---------------------------------------------------------------------------

model Booking {
  id          String        @id @default(uuid())
  orderNumber String        @unique
  userId      String
  propertyId  String
  roomId      String
  checkIn     DateTime      @db.Date
  checkOut    DateTime      @db.Date
  guestCount  Int           @default(1)
  totalPrice  Decimal       @db.Decimal(12, 2)
  status      BookingStatus @default(WAITING_PAYMENT)

  paymentMethod          PaymentMethod @default(MANUAL_TRANSFER)
  paymentDeadline        DateTime?
  paymentProofUrl        String?
  paymentProofUploadedAt DateTime?

  confirmedAt   DateTime?
  cancelledAt   DateTime?
  cancelledBy   CancelledBy?
  cancelReason  String?
  reminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id])
  property Property       @relation(fields: [propertyId], references: [id])
  room     Room           @relation(fields: [roomId], references: [id])
  nights   BookingNight[]
  review   Review?

  @@index([userId, status])
  @@index([propertyId, status])
  @@index([status, paymentDeadline])
  @@index([checkIn])
  @@map("bookings")
}

/// Per-night price snapshot taken at booking time. Keeps historical totals
/// correct when a tenant later edits base prices or peak season rates, and
/// makes the sales report a straight aggregation.
model BookingNight {
  id                 String   @id @default(uuid())
  bookingId          String
  date               DateTime @db.Date
  basePrice          Decimal  @db.Decimal(12, 2)
  finalPrice         Decimal  @db.Decimal(12, 2)
  peakSeasonRateName String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, date])
  @@index([date])
  @@map("booking_nights")
}

model Review {
  id         String   @id @default(uuid())
  bookingId  String   @unique
  userId     String
  propertyId String
  rating     Int
  comment    String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  booking  Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id])
  property Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reply    ReviewReply?

  @@index([propertyId])
  @@map("reviews")
}

model ReviewReply {
  id        String   @id @default(uuid())
  reviewId  String   @unique
  tenantId  String
  comment   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review Review        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  tenant TenantProfile @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("review_replies")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String           @db.Text
  bookingId String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}
