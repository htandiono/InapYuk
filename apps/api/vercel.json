{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }],
  "crons": [
    {
      "path": "/api/cron/expire-unpaid-bookings",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/checkin-reminder",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron/complete-bookings",
      "schedule": "0 1 * * *"
    }
  ]
}
